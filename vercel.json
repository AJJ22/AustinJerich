{
  "buildCommand": "npm install --prefix ./api && cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/build",
  "builds": [
    {
      "src": "index.mjs",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "api/**"
    }
  },
  "routes": [
    {
      "src": "/api/.*",
      "dest": "/api/index.mjs"
    },
    {
      "src": "/(?!(api|static|manifest|robots|favicon|index\\.html)).*",
      "dest": "/index.html"
    }
  ]
}